#=============================================================================#
# pRCC-RNA-Seq — keep the repo to the PIPELINE only.
# Everything below is large and/or regenerable; never commit it.
#=============================================================================#

# GDC reference bundle (~59 GB) — rebuild with: bash resources/get_gdc_references.sh resources/gdc
resources/gdc/

# Apptainer/Singularity images (~1.4 GB) — rebuild with: bash containers/pull_images.sh
containers/sif/

# Raw / test sequencing data (never in git)
*.fastq
*.fastq.gz
*.fq.gz
*.bam
*.bai
*.sif

# Exception: Synthetic fixtures ARE intentionally version controlled
!tests/synthetic/data/*.fastq.gz

# Synthetic generated artifacts are not
tests/synthetic/results/
tests/synthetic/reference/star_index/

# Real sequencing test data are obtained separately, not stored in Git
tests/real/data/
tests/real/results/

# Snakemake state, logs, scratch
.snakemake/
logs/
*.log
tmp/
.cache/
.java/

# Python / editor cruft
__pycache__/
*.pyc
.ipynb_checkpoints/
.DS_Store
